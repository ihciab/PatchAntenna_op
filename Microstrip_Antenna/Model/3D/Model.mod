'# MWS Version: Version 2023.4 - Apr 26 2023 - ACIS 32.0.1 -

'# length = mm
'# frequency = GHz
'# time = ns
'# frequency range: fmin = 6 fmax = 14
'# created = '[VERSION]2023.4|32.0.1|20230426[/VERSION]


'@ set frequency

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
Solver.FrequencyRange "6", "14"

'@ set planewave

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With PlaneWave
.Reset
.Normal "0", "0", "1"
.EVector "1", "0", "0"
.Polarization "Linear"
.Store
End With

'@ set boundaries

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With Boundary
.Xmin "expanded open"
.Xmax "expanded open"
.Ymin "expanded open"
.Ymax "expanded open"
.Zmin "expanded open"
.Zmax "expanded open"
.Xsymmetry "none"
.Ysymmetry "none"
.Zsymmetry "none"
.ApplyInAllDirections "True"
.XPeriodicShift "0.0"
.YPeriodicShift "0.0"
.ZPeriodicShift "0.0"
.PeriodicUseConstantAngles "False"
End With

'@ set background

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With Background
.ResetBackground
.XminSpace "0.0"
.XmaxSpace "0.0"
.YminSpace "0.0"
.YmaxSpace "0.0"
.ZminSpace "25"
.ZmaxSpace "25"
.ApplyInAllDirections "False"
End With

'@ set change solver

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
ChangeSolverType "HF Frequency Domain"

'@ set timesolver

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With FDSolver
.Reset
.SetMethod "Tetrahedral", "General purpose"
.OrderTet "Second"
.OrderSrf "First"
.Stimulation "1", "All"
End With

'@ set field monitor

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With Monitor
.Reset
.Name "e-field (f=10.0)"
.Dimension "Volume"
.Domain "Frequency"
.FieldType "Efield"
.MonitorValue "10.0"
.UseSubvolume "False"
.Coordinates "Structure"
.Create
End With

'@ load Rogers RT-duroid 5880 (loss free)

'[VERSION]2023.4|32.0.1|20230426[/VERSION]
With Material
.Reset
.Name "Rogers RT-duroid 5880 (loss free)"
.Folder ""
.FrqType "all"
.Type "Normal"
.SetMaterialUnit "GHz", "mm"
.Epsilon "2.2"
.Mu "1.0"
.Kappa "0.0"
.TanD "0.0"
.TanDFreq "0.0"
.TanDGiven "False"
.TanDModel "ConstTanD"
.KappaM "0.0"
.TanDM "0.0"
.TanDMFreq "0.0"
.TanDMGiven "False"
.TanDMModel "ConstKappa"
.DispModelEps "None"
.DispModelMu "None"
.DispersiveFittingSchemeEps "General 1st"
.DispersiveFittingSchemeMu "General 1st"
.UseGeneralDispersionEps "False"
.UseGeneralDispersionMu "False"
.Rho "0.0"
.ThermalType "Normal"
.ThermalConductivity "0.20"
.SetActiveMaterial "all"
.Colour "0.75", "0.95", "0.85"
.Wireframe "False"
.Transparency "0"
.Create
End With

